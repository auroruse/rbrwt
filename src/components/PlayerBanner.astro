---
// One player in a franchise's roster: a banner in the franchise's colours with the name, the S1 figures under
// it, and a click that slides out the rest: S1 franchises, awards, titles, best game, finals, then each tour.
import TeamMarks from './TeamMarks.astro';
import { AWARDS, franchiseOrNull, type TierPlayer } from '../lib/data';
import { AWARD_NAMES } from '../lib/tiers';
import { CARET } from '../lib/icons';
interface Props { p: TierPlayer; n: number; code: string; firstSub?: boolean }
const { p, n, code, firstSub = false } = Astro.props;
const f = franchiseOrNull(code);
const id = `pl-${code.toLowerCase().replace(/[^a-z0-9]+/g, '')}-${p.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const pad2 = (x: number) => String(x).padStart(2, '0');
const won = AWARDS.filter((a) => p.awards[a]?.length);
---
<li class={firstSub ? 'pl pl-first-sub' : 'pl'}>
  <button type="button" class="pl-head" aria-expanded="false" aria-controls={id} style={f?.style}>
    <span class="pl-band">
      <span class="pl-num">{pad2(n)}</span>
      <span class="pl-who">
        <span class="pl-name slide"><span>{p.name}</span></span>
        {f && <span class="pl-team">{f.code} {f.name}</span>}
      </span>
      <Fragment set:html={CARET} />
    </span>
    {p.games
      ? <span class="tp-figs">
          <span class="tf"><b>{p.kpg.toFixed(2)}</b><em>K/G</em></span>
          <span class="tf"><b>{p.kills}</b><em>Kills</em></span>
          <span class="tf"><b>{p.games}</b><em>Games</em></span>
          <span class="tf"><b>{p.rank ? pad2(p.rank) : ''}</b><em>Rank</em></span>
        </span>
      : <span class="tp-note tp-empty">No S1 games</span>}
    {p.low && <span class="tp-note">Under 10 games</span>}
  </button>
  <div class="pl-more" id={id} inert>
    <div class="pl-more-in">
      <dl class="tp-list">
        {p.teams.length > 0 && <div><dt>S1 teams</dt><dd><TeamMarks codes={p.teams} /></dd></div>}
        {won.length > 0 && (
          <div><dt>Awards</dt><dd>{won.map((a) => (
            <span class="tp-aw" title={AWARD_NAMES[a]}><svg viewBox="0 0 20 20" aria-hidden="true"><use href={`#aw-${a}`} /></svg>{a} <em>{p.awards[a]!.join(', ')}</em></span>
          ))}</dd></div>
        )}
        {p.titles.length > 0 && <div><dt>Titles</dt><dd>{p.titles.join(', ')}</dd></div>}
        {p.best && <div><dt>Best game</dt><dd>{p.best.kills} kills · {p.best.tours.join(', ')}</dd></div>}
        {p.finals.length > 0 && <div><dt>Finals</dt><dd>{p.finals.join(', ')}</dd></div>}
      </dl>
      {p.tours.length > 0 && (
        <table class="tp-tours">
          <thead><tr><th>Tour</th><th>Team</th><th>K</th><th>G</th><th>K/G</th></tr></thead>
          <tbody>
            {p.tours.map((t) => (
              <tr><td>{t.num}</td><td>{t.team && <TeamMarks codes={[t.team]} />}</td><td>{t.kills}</td><td>{t.games}</td><td>{t.games ? (t.kills / t.games).toFixed(2) : ''}</td></tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </div>
</li>
