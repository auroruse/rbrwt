---
// The pieces each franchise's animation moves, laid over its logo. The motion itself is in site.css under
// "Franchise animations". A franchise with no animation of its own gets the generic one.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { fx: string; image?: ImageMetadata }
const { fx, image } = Astro.props;
// The NBB dog's arcs of sound, one bark's worth: three rings opening forward from its mouth.
const rings = [10, 18, 26].map((r) => {
  const x = (r * Math.cos(Math.PI * 38 / 180)).toFixed(2), y = (r * Math.sin(Math.PI * 38 / 180)).toFixed(2);
  return `M${x} -${y}A${r} ${r} 0 0 1 ${x} ${y}`;
});
---
<span class="fx" aria-hidden="true">
  {fx === 'css' && <Fragment><i class="fx-smoke s1"></i><i class="fx-smoke s2"></i><i class="fx-smoke s3"></i><i class="fx-shell"></i><i class="fx-flash"></i></Fragment>}
  {fx === 'sld' && <Fragment><svg class="fx-flame" viewBox="0 0 100 40"><path class="o" d="M104 5C84 3 64 1 40 9L46 13C30 13 14 16 0 20C14 24 30 27 46 27L40 31C64 39 84 37 104 35Z" /><path class="m" d="M104 11C86 10 68 9 50 15C40 18 30 20 24 20C30 20 40 22 50 25C68 31 86 30 104 29Z" /><path class="c" d="M104 15C92 15 80 16 70 20C80 24 92 25 104 25Z" /></svg><i class="fx-spark k1"></i><i class="fx-spark k2"></i><i class="fx-spark k3"></i><i class="fx-spark k4"></i></Fragment>}
  {fx === 'tal' && (
    <Fragment>
      <i class="fx-aura"></i>
      <svg class="fx-tri t1" viewBox="-50 -50 100 100"><polygon points="0,-40 34.6,20 -34.6,20" /></svg>
      <svg class="fx-tri t2" viewBox="-50 -50 100 100"><polygon points="0,-40 34.6,20 -34.6,20" /></svg>
      <svg class="fx-tri t3" viewBox="-50 -50 100 100"><polygon points="0,-40 34.6,20 -34.6,20" /></svg>
      <i class="fx-feather f1"></i><i class="fx-feather f2"></i><i class="fx-feather f3"></i>
      <i class="fx-eye"></i>
    </Fragment>
  )}
  {fx === 'to' && (
    <Fragment>
      <svg class="fx-star" viewBox="-50 -50 100 100"><polygon points="0.0,-46.0 11.2,-15.4 43.7,-14.2 18.1,5.9 27.0,37.2 0.0,19.0 -27.0,37.2 -18.1,5.9 -43.7,-14.2 -11.2,-15.4" /></svg>
      <i class="fx-speed v1"></i><i class="fx-speed v2"></i><i class="fx-speed v3"></i>
      <i class="fx-dust d1"></i><i class="fx-dust d2"></i><i class="fx-dust d3"></i>
    </Fragment>
  )}
  {fx === 'so' && (
    <Fragment>
      <svg class="fx-swell" viewBox="0 0 200 20" preserveAspectRatio="none"><path class="w1" d="M0 8Q12.5 2 25 8T50 8T75 8T100 8T125 8T150 8T175 8T200 8" /><path class="w2" d="M0 14Q12.5 8 25 14T50 14T75 14T100 14T125 14T150 14T175 14T200 14" /></svg>
      <i class="fx-ripple p1"></i><i class="fx-ripple p2"></i><i class="fx-ripple p3"></i>
      <i class="fx-drop o1"></i><i class="fx-drop o2"></i><i class="fx-drop o3"></i><i class="fx-drop o4"></i><i class="fx-drop o5"></i>
    </Fragment>
  )}
  {fx === 'tnp' && (
    <Fragment>
      <svg class="fx-burst" viewBox="-50 -50 100 100"><path d="M0 -31V-46M22 -22L33 -33M31 0H46M22 22L33 33M0 31V46M-22 22L-33 33M-31 0H-46M-22 -22L-33 -33" /></svg>
      <i class="fx-ring r1"></i><i class="fx-ring r2"></i>
      <i class="fx-snort n1"></i><i class="fx-snort n2"></i>
    </Fragment>
  )}
  {fx === 'tpop' && <i class="fx-rays"></i>}
  {fx === 'nbb' && image && (
    <Fragment>
      <i class="fx-mouth"></i>
      <svg class="fx-fangs" viewBox="0 0 500 500"><path d="M381 256.1L391 254.7L386.5 268ZM366 258.1L373 257.2L369.5 265.5Z" /></svg>
      <span class="fx-jaw"><span class="fx-jaw-in"><svg viewBox="0 0 500 500"><path d="M371 261.4L380 260.2L376.5 249.5Z" /></svg><Image src={image} alt="" width={480} /></span></span>
      <svg class="fx-bark b1" viewBox="-50 -50 100 100">{rings.map((d) => <path d={d} />)}</svg>
      <svg class="fx-bark b2" viewBox="-50 -50 100 100">{rings.map((d) => <path d={d} />)}</svg>
    </Fragment>
  )}
</span>
