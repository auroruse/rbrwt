---
import Site from '../layouts/Site.astro';
import { href, season } from '../lib/data';
const NEXT = '<svg viewBox="0 0 22 12" aria-hidden="true"><path d="M0 6h20M15 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>';
---
<Site current="stats" inner title="Stats · RBR World Tour" description={`Season ${season.season} statistics of the Rocket Bot Royale World Tour.`}>
  <div class="depth">
    <section class="sec sec-first sec-last">
      <div class="wrap">
        <header class="sec-head reveal">
          <h1 class="mega">Stats</h1>
          <div class="sec-meta"><span class="sec-count">S{season.season}</span><span class="label">Season {season.season}</span></div>
        </header>
        <div class="empty cut reveal"><b>Starts at {season.next.num}</b></div>
        <a class="cta reveal" href={href('/#history')}>Season 1 records<Fragment set:html={NEXT} /></a>
      </div>
    </section>
  </div>
</Site>
