---
// The player card on pages outside the Tier List: any PlayerName opens the same readout a tier card shows.
import AwardSprite from './AwardSprite.astro';
import { tierAssets } from '../lib/tier-assets';
// freeAgents: show players on no S2 roster as free agents, as Franchises does; Stats and History leave it off.
interface Props { freeAgents?: boolean }
const { json } = await tierAssets({ freeAgents: Astro.props.freeAgents });
---
<AwardSprite />
<div class="tl-pop" id="tl-pop" aria-hidden="true" hidden></div>
<div class="tl-bar" id="tl-bar" role="dialog" aria-label="Player card" hidden></div>
<script type="application/json" id="tl-data" set:html={json}></script>
<script>import '../scripts/player-cards';</script>
