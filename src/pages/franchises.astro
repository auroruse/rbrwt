---
import { Image } from 'astro:assets';
import Site from '../layouts/Site.astro';
import { nsRegion, rosters, s2Field, season, tierPlayers } from '../lib/data';
import { ARROW } from '../lib/icons';
import PlayerBanner from '../components/PlayerBanner.astro';
import AwardSprite from '../components/AwardSprite.astro';

const pad2 = (n: number) => String(n).padStart(2, '0');
const byName = new Map(tierPlayers.map((p) => [p.name, p]));
const isSub = (role: string) => role.toLowerCase() === 'sub';
---
<Site current="franchises" inner title="Franchises · RBR World Tour" description={`The ${s2Field.length} franchises of Season ${season.season} of the Rocket Bot Royale World Tour.`}>
  <div class="depth">
    <div class="rays" aria-hidden="true"></div>
    <section class="sec sec-first sec-last" aria-labelledby="fr-h">
      <div class="wrap">
        <header class="sec-head reveal">
          <h1 class="mega" id="fr-h">Franchises</h1>
          <div class="sec-meta"><span class="sec-count">{pad2(s2Field.length)}</span><span class="label">Season {season.season}</span></div>
        </header>
        <div class={s2Field.length === 4 ? 'teams n4' : 'teams'}>
          {s2Field.map((f, i) => {
            const roster = rosters.get(f.code) ?? [];
            return (
              <article class="team cut reveal" style={`--i:${i}; ${f.style}`}>
                <div class="team-field">
                  <span class="team-code">{f.code}</span>
                  {f.image && <Image src={f.image} alt={`${f.code} ${f.name} logo`} width={520} />}
                  <span class="team-sweep"></span>
                </div>
                <div class="team-body">
                  <p class="team-home slide">
                    {f.home?.region
                      ? <a href={nsRegion(f.home.region)} target="_blank" rel="noopener">{f.home.label}<Fragment set:html={ARROW} /></a>
                      : <span>{f.home?.label ?? ''}</span>}
                  </p>
                  <h2 class="team-name slide"><span>{f.name}</span></h2>
                  <ol class="pl-list">
                    {roster.length
                      ? roster.map((r, k) => {
                          const p = byName.get(r.player);
                          const firstSub = isSub(r.role) && k > 0 && !isSub(roster[k - 1].role);
                          return p
                            ? <PlayerBanner p={p} n={k + 1} code={f.code} firstSub={firstSub} />
                            : <li class={firstSub ? 'pl pl-first-sub pl-plain' : 'pl pl-plain'}>{r.player}</li>;
                        })
                      : <li class="pl pl-plain"><span class="na">Roster TBA</span></li>}
                  </ol>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </div>
  <AwardSprite />
  <script is:inline>
  // A banner slides its trivia and tours open below it, and shut again.
  document.querySelectorAll('.pl-head').forEach(function (b) {
    b.addEventListener('click', function () {
      var open = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
      var more = document.getElementById(b.getAttribute('aria-controls'));
      if (more) { more.inert = !open; }
    });
  });
  </script>
</Site>
