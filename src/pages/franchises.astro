---
import { Image } from 'astro:assets';
import Site from '../layouts/Site.astro';
import PlayerName from '../components/PlayerName.astro';
import PlayerCards from '../components/PlayerCards.astro';
import FranchiseFx from '../components/FranchiseFx.astro';
import { nsRegion, official, rosters, s2Field, season, tierPlayers } from '../lib/data';
import { ARROW } from '../lib/icons';
import { TIERS, starsSVG } from '../lib/tiers';

const pad2 = (n: number) => String(n).padStart(2, '0');
const byName = new Map(tierPlayers.map((p) => [p.name, p]));
const isSub = (role: string) => role.toLowerCase() === 'sub';
// Each player's tier on Kirin's List, shown in its mineral stars.
const tierOf = new Map(official.tiers.flatMap((t) => t.players.map((n) => [n, TIERS.find((x) => x.id === t.id)!] as const)));
// The franchises with an animation of their own; any other gets the generic one.
const FX = new Set(['css', 'sld', 'tal', 'to', 'tpop']);
const fxOf = (code: string) => (FX.has(code.toLowerCase()) ? code.toLowerCase() : 'generic');
---
<Site current="franchises" inner title="Franchises · RBR World Tour" description={`The ${s2Field.length} franchises of Season ${season.season} of the Rocket Bot Royale World Tour.`}>
  <div class="depth">
    <div class="rays" aria-hidden="true"></div>
    <section class="sec sec-first sec-last" aria-labelledby="fr-h">
      <div class="wrap">
        <header class="sec-head reveal">
          <h1 class="mega" id="fr-h">Franchises</h1>
          <div class="sec-meta"><span class="sec-count">{pad2(s2Field.length)}</span><span class="label">Season {season.season}</span></div>
        </header>
        <div class="reveal">
          <div class="fband" id="fband">
            {s2Field.map((f) => {
              const roster = rosters.get(f.code) ?? [];
              return (
                <article class="fp cut" style={f.style} data-fx={fxOf(f.code)}>
                  <button type="button" class="fp-toggle" aria-expanded="false" aria-controls={`roster-${f.code.toLowerCase()}`} aria-label={`${f.code} ${f.name} roster`}></button>
                  <div class="fp-id">
                    <span class="fp-code">{f.code}</span>
                    <span class={`fp-art fx-${fxOf(f.code)}`}>
                      {f.image && <Image class="fp-logo" src={f.image} alt={`${f.code} ${f.name} logo`} width={480} />}
                      <FranchiseFx fx={fxOf(f.code)} />
                    </span>
                    <i class="fx-sweep" aria-hidden="true"></i>
                    <div class="fp-title">
                      <p class="fp-home slide">
                        {f.home?.region
                          ? <a href={nsRegion(f.home.region)} target="_blank" rel="noopener">{f.home.label}<Fragment set:html={ARROW} /></a>
                          : <span>{f.home?.label ?? ''}</span>}
                      </p>
                      <h2 class="fp-name slide"><span>{f.name}</span></h2>
                    </div>
                  </div>
                  <span class="fp-strip" aria-hidden="true">{f.image && <Image src={f.image} alt="" width={96} />}<b>{f.name}</b></span>
                  <div class="fp-roster" id={`roster-${f.code.toLowerCase()}`}>
                    <table class="fp-table">
                      <colgroup><col style="width:40px"><col><col style="width:104px"><col style="width:64px"><col class="kl" style="width:58px"><col class="gp" style="width:64px"><col class="rkc" style="width:54px"></colgroup>
                      <thead><tr><th>#</th><th>Player</th><th>Tier</th><th class="n">K/G</th><th class="n kl">Kills</th><th class="n gp">Games</th><th class="n rkc">Rank</th></tr></thead>
                      <tbody>
                        {roster.length
                          ? roster.map((r, k) => {
                              const p = byName.get(r.player);
                              const lastStarter = !isSub(r.role) && k + 1 < roster.length && isSub(roster[k + 1].role);
                              return (
                                <tr class={lastStarter ? 'last-starter' : undefined}>
                                  <td class="rk">{pad2(k + 1)}</td>
                                  <td class="pl"><span class="slide"><span><PlayerName name={r.player} /></span></span></td>
                                  <td class="kls">{tierOf.get(r.player)
                                    ? <span class="kls-stars" title={`${tierOf.get(r.player)!.stars} stars`}><Fragment set:html={starsSVG(tierOf.get(r.player)!, 14, 2)} /></span>
                                    : <span class="na">Unranked</span>}</td>
                                  <td class="n key">{p?.games ? p.kpg.toFixed(2) : ''}</td>
                                  <td class="n kl">{p?.games ? p.kills : ''}</td>
                                  <td class="n gp">{p?.games ? p.games : ''}</td>
                                  <td class="n rkc">{p?.rank ? pad2(p.rank) : ''}</td>
                                </tr>
                              );
                            })
                          : <tr><td class="rk">00</td><td class="pl"><span class="na">Roster TBA</span></td><td></td><td></td><td class="kl"></td><td class="gp"></td><td class="rkc"></td></tr>}
                      </tbody>
                    </table>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  </div>
  <PlayerCards />
  <script is:inline>
  // A click opens a team across the band and plays its animation; a click on it again, a click outside the
  // band or Escape shuts it. A mouse resting on a closed team plays a short preview of its animation.
  (function () {
    var band = document.getElementById('fband');
    if (!band) { return; }
    var panels = band.querySelectorAll('.fp');
    function play(p, kind, ms) {
      p.classList.remove('fx-preview', 'fx-full');
      void p.offsetWidth;
      p.classList.add(kind);
      clearTimeout(p.fxTimer);
      p.fxTimer = setTimeout(function () { p.classList.remove(kind); }, ms);
    }
    function open(p) {
      panels.forEach(function (o) {
        var on = o === p;
        o.classList.toggle('is-open', on);
        o.querySelector('.fp-toggle').setAttribute('aria-expanded', on ? 'true' : 'false');
      });
      band.classList.toggle('has-open', !!p);
      if (p) { play(p, 'fx-full', 1800); }
    }
    panels.forEach(function (p) {
      p.querySelector('.fp-toggle').addEventListener('click', function () { open(p.classList.contains('is-open') ? null : p); });
      p.addEventListener('pointerenter', function (e) {
        if (e.pointerType !== 'mouse' || band.classList.contains('has-open')) { return; }
        if (Date.now() - (p.fxLast || 0) < 1400) { return; }
        p.fxLast = Date.now();
        play(p, 'fx-preview', 1000);
      });
    });
    document.addEventListener('click', function (e) { if (band.classList.contains('has-open') && !band.contains(e.target)) { open(null); } });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && band.classList.contains('has-open')) { open(null); } });
  })();
  </script>
</Site>
