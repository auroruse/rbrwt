---
import Site from '../layouts/Site.astro';
import { season } from '../lib/data';
---
<Site current="tours" inner title="Tours · RBR World Tour" description={`Season ${season.season} tours of the Rocket Bot Royale World Tour.`}>
  <div class="depth">
    <section class="sec sec-first sec-last">
      <div class="wrap">
        <header class="sec-head reveal">
          <h1 class="mega">Tours</h1>
          <div class="sec-meta"><span class="sec-count">00</span><span class="label">Season {season.season} tours</span></div>
        </header>
        <div class="empty cut reveal"><b>RBRWT {season.next.num}</b><span>{season.next.date ? 'Coming up' : 'Date TBA'}</span></div>
      </div>
    </section>
  </div>
</Site>
