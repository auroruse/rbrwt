---
// What a Season 2 page shows before the season starts: built like the countdown strip.
import { season } from '../lib/data';
interface Props { what: string }
const { what } = Astro.props;
const when = season.next.date ? String(season.next.date) : null;
---
<div class="s2-wait cut reveal">
  <p class="sub">Season {season.season}</p>
  <p class="s2-wait-h">Starts with RBRWT {season.next.num}</p>
  <p class="s2-wait-p">Season {season.season} {what} will be added here once the season starts.</p>
  <div class="s2-wait-read">
    <div class="hud-cell"><span class="hud-k">Next tour</span><span class="hud-v">RBRWT {season.next.num}</span></div>
    <div class="hud-cell">
      <span class="hud-k">{when ? 'Starts in' : 'Starts'}</span>
      {when
        ? <span class="hud-v mono js-countdown" data-date={when}></span>
        : <span class="hud-v">Date TBA<i class="cursor" aria-hidden="true"></i></span>}
    </div>
  </div>
</div>
